{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "op:persistent_pillager",         //persists even in peaceful difficulty
      // "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true,
      
      "properties": {
        "var:peaceful_received": {
          "client_sync": false,
          "type": "bool",
          "default": false
        },
        "var:not_peaceful_received": {
          "client_sync": false,
          "type": "bool",
          "default": false
        },
        "var:site_is_ok": {
          "client_sync": false,
          "type": "bool",
          "default": false
        },
        "var:finished_random_stroll": {
          "client_sync": false,
          "type": "bool",
          "default": false
        },

        // ** Home coords **
        "var:x": {
          "client_sync": false,
          "type": "int",
          "default": 0,
          "range": [-16500000, 16500000]
        },
        "var:y": {
          "client_sync": false,
          "type": "int",
          "default": 70,
          "range": [-16500000, 16500000]
        },
        "var:z": {
          "client_sync": false,
          "type": "int",
          "default": 0,
          "range": [-16500000, 16500000]
        }

        // *** Unused ***
        // "var:num_timer_cycles": {
        //   "client_sync": false,
        //   "type": "int",
        //   "range": [-1, 3000],
        //   "default": 0
        // }
      }
    },

    "component_groups": {
      "minecraft:celebrate": {
        "minecraft:behavior.celebrate": {
          "priority": 5,
          "celebration_sound": "celebrate",
          "sound_interval": {
            "range_min": 2.0,
            "range_max": 7.0
          },
          "jump_interval": {
            "range_min": 1.0,
            "range_max": 3.5
          },
          "duration": 30.0,
          "on_celebration_end_event": {
            "event": "minecraft:stop_celebrating",
            "target": "self"
          }
        }
      },

      "minecraft:ranged_attack": {
        "minecraft:behavior.ranged_attack": {
          "priority": 4,
          "attack_interval_min": 1.0,
          "attack_interval_max": 1.0,
          "attack_radius": 8.0
        },
        "minecraft:shooter": {
          "def": "minecraft:arrow"
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "test": "is_underwater",
                "subject": "self",
                "operator": "==",
                "value": true
              },
              "event": "minecraft:melee_mode"
            },
            {
              "filters": {
                "all_of": [
                  {"test": "bool_property", "domain": "var:peaceful_received", "value": false},
                  {"test": "is_difficulty", "value": "peaceful"}
                ]
              },
              "event": "peaceful"
            },
            {
              "filters": {
                "all_of": [
                  {"test": "bool_property", "domain": "var:not_peaceful_received", "value": false},
                  {"test": "is_difficulty", "operator": "!=", "value": "peaceful"}
                ]
              },
              "event": "not_peaceful"
            }
          ]
        }
      },

      "minecraft:melee_attack": {
        "minecraft:behavior.melee_box_attack": {
          "priority": 4,
          "track_target": true
        },
        "minecraft:attack": {
          "damage": 3
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "test": "in_water",
                "subject": "self",
                "operator": "==",
                "value": false
              },
              "event": "minecraft:ranged_mode"
            },
            {
              "filters": {
                "all_of": [
                  {"test": "bool_property", "domain": "var:peaceful_received", "value": false},
                  {"test": "is_difficulty", "value": "peaceful"}
                ]
              },
              "event": "peaceful"
            },
            {
              "filters": {
                "all_of": [
                  {"test": "bool_property", "domain": "var:not_peaceful_received", "value": false},
                  {"test": "is_difficulty", "operator": "!=", "value": "peaceful"}
                ]
              },
              "event": "not_peaceful"
            }
          ]
        }
      },

      "move_to_land": {
        "minecraft:behavior.move_to_land": {
          "goal_radius": 0.5,
          "search_height": 5,
          "search_range": 32,
          "search_count": 10
        },
        "minecraft:timer": {
          "time": 15,
          "looping": true,
          "time_down_event": {
            "event": "timeout_move_to_land",
            "target": "self"
          }
        }
      },

      "default_random_stroll": {
          "minecraft:behavior.random_stroll": {
          "priority": 8,
          "speed_multiplier": 1
        }
      },

      "random_stroll": {
        "minecraft:behavior.random_stroll": {
          "priority": 4,
          "interval": 200,
          "xz_dist": 64,
          "y_dist": 7
        },
        "minecraft:behavior.timer_flag_1": {
          "on_end": {
            "target": "self",
            "event": "finished_random_stroll"
          }
        }
      },

      "move_to_random_block": {
        "minecraft:behavior.move_to_random_block": {
          "priority": 4,
          "block_distance": 40,
          "within_radius": 4
        },
        "minecraft:timer": {
          "time": 15,
          "looping": false,
          "time_down_event": {
            "event": "timeout_move_to_random_block",
            "target": "self"
          }
        }
      },

      //using attack targeting to make our pillager move to settlement
      "move_to_settled_pillagers": {
        //********** Might need to use this \/  \/ ***********
        // "minecraft:behavior.move_towards_target": {
        //   "priority": 2,
        //   "within_radius": 20
        // },
        "minecraft:behavior.nearest_attackable_target": {
          "attack_owner": false,
          "must_reach": false,
          "must_see": false,
          "reselect_targets": true,
          "scan_interval": 20,
          "target_search_height": 350,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  {"test": "is_family", "subject": "other", "value": "settled_pillager"},
                  {"test": "is_family", "subject": "other", "value": "governor_pillager"}
                ]
              },
              "max_dist": 600
            }
          ]
        },
        "minecraft:on_target_acquired": "target_acquired_during_search",
        "minecraft:timer": {
          "time": 10,
          "looping": true,
          "time_down_event": {
            "event": "check_for_nearby_settlements",
            "target": "self"
          }
        }
      },

      "avoid_players_and_villagers": {
        "minecraft:behavior.avoid_mob_type": {
          "priority": 3,
          "max_dist": 275,
          "max_flee": 265,
          "sprint_speed_multiplier": 1.0,
          "probability_per_strength": 0,
          "ignore_visibility": true,
          "remove_target": false,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  {"test": "is_family", "subject": "other", "value": "player"},
                  {"test": "is_family", "subject": "other", "value": "villager"},
                  {"test": "is_family", "subject": "other", "value": "wandering_trader"},
                  {"test": "has_tag", "subject": "other", "value": "pillagers_avoid"} //for testing
                ],
                "none_of": [
                  {"test": "has_tag", "subject": "other", "value": "pillager_exempt"} //for testing
                ]
                // There were doubts about this combination of filters, but it works. Player with 
                // "pillager_exempt" tag is truly exempted from the avoid behavior.
              }
            }
          ],
          "on_escape_event": {
            "event": "escaped_player_or_villager",
            "target": "self"
          }
        },
        "minecraft:timer": {
          "time": 6,
          "looping": true,
          "time_down_event": {
            "event": "refresh_avoid_behavior",
            "target": "self"
          }
        }
      },

      "ticks_world": {
        "minecraft:tick_world": {
          "never_despawn": true,
          "radius": 2
        }
      },

      "persistence": {
        "minecraft:persistent": {}
      },

      "pillager_settlement_configuration": {
        "minecraft:dweller": {
          "dwelling_type": "village", //I wish I could create new one
          "dweller_role": "inhabitant",
          "update_interval_base": 80,
          "update_interval_variant": 40,
          "can_find_poi": true,
          "can_migrate": true,  //tbd for this
          "first_founding_reward": 5
        },
        "minecraft:behavior.move_towards_dwelling_restriction": {
          "priority": 11
        },
        "minecraft:behavior.move_to_village": {
          "priority": 15,
          "goal_radius": 3.0
        }
      },

      "minecraft:raid_configuration": {
        "minecraft:dweller": {
          "dwelling_type": "village",
          "dweller_role": "hostile",
          "update_interval_base": 60,
          "update_interval_variant": 40,
          "can_find_poi": false,
          "can_migrate": true,
          "first_founding_reward": 0
