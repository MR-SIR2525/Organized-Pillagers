          {
            "filters": {
              "test": "has_component", "subject": "other", "value": "minecraft:is_baby"
            },
            "add": {"component_groups": ["baby"]}
          },
          {"trigger": "persistence_on"},
          {"trigger": "ticks_world_on"},
          {"trigger": "check_for_nearby_settlements"}
        ]
      },

      "check_for_nearby_settlements": {
        "queue_command": {
          "command": [
            "msg @a[r=1500] §eChecking for nearby settlements.",
            // if settled pillagers nearby, move to them
            "execute as @s at @s if entity @e[family=settled_pillager,r=600,rm=1] run event entity @s move_to_settled_pillagers",
            // if not settled pillagers nearby, move away from players and villagers
            "execute as @s at @s unless entity @e[family=settled_pillager,r=600,rm=1] run event entity @s avoid_players_and_villagers"
          ]
        }
      },

      "move_to_settled_pillagers": {
        "trigger": "minecraft:calm",
        "remove": {"component_groups": ["avoid_players_and_villagers"]},
        "add": {"component_groups": ["move_to_settled_pillagers"]},
        "queue_command": {
          "command": "msg @a[r=1500] §eMoving to settled pillagers."   //for debug
        }
      },

      "avoid_players_and_villagers": {
        "remove": {"component_groups": ["move_to_settled_pillagers"]},
        "add": {"component_groups": ["avoid_players_and_villagers"]},
        // - comes with timer to trigger refresh avoid behavior (below)
        "queue_command": {
          "command": "msg @a[r=1500] §eAvoiding players and villagers."   //for debug
        }
      },

      "refresh_avoid_behavior": {
        "queue_command": {"command": [
          "msg @a[r=1500] §eRefresh avoid behavior event.",
          // don't run if settled pillagers or players in range
          "execute as @s at @s unless entity @e[family=settled_pillager,r=600,rm=1] unless entity @e[family=player,family=villager,tag=!pillager_exempt,r=260] run event entity @s avoid_players_and_villagers",
          
          // don't run if settled pillagers in range
          "execute as @s at @s unless entity @e[family=settled_pillager,r=600,rm=1] run event entity @s escaped_player_or_villager",

          // run if settled pillagers in range
          "execute as @s at @s if entity @e[family=settled_pillager,r=600,rm=1] run event entity @s move_to_settled_pillagers"
        ]}
      },

      "stop_avoiding_players_and_villagers": {
        "remove": {"component_groups": ["avoid_players_and_villagers"]},
        "queue_command": {
          "command": "msg @a[r=1500] §e No longer avoiding players and villagers."   //for debug
        }
      },

      "escaped_player_or_villager": {
        //Because the refresh avoid behavior event should catch nearby settlements and remove
        //the avoid behavior. This event assumes no nearby settlements and, if pillager escaped
        //all players/villagers, we move on to initiating a new settlement.
        "queue_command": {
          "command": [
            "msg @a[r=1500] §eEscaped a player or villager.",
            //if escaped all players/villagers, look for spot to create new settlement
            "execute as @s at @s unless entity @e[r=260,type=player,tag=!pillager_exempt] unless entity @e[r=255,family=villager,tag=!pillager_exempt] run event entity @s find_spot_to_create_settlement"
            //else, do nothing (continue avoidance)
          ]
        }
      },

      "find_spot_to_create_settlement": {
        "sequence": [
          {
            "remove": {
              "component_groups": ["avoid_players_and_villagers", "move_to_settled_pillagers"]
            },
            "queue_command": {
              "command": [
                "msg @a[r=1500] §eFinding a spot to create a settlement.",
                "tag @s add trying_to_create_settlement"
              ]
            },
            "trigger": "governor_pillager"
          },
          {
            //this is where script jumps in
            "queue_command": {
              "command": "scriptevent op:find_spot_for_settlement ..."
            }
          }
        ]
      },

      //for script testing
      "run_randomStrollToNewSpot": {
        "queue_command": {
          "command": "scriptevent op:randomStrollToNewSpot ..."
        }
      },

      "move_to_random_block": {
        "add": {"component_groups": ["move_to_random_block"]},
        "queue_command": {"command": "msg @a[r=1500] §eMoving to random block."}  //for debug
      },

      "random_stroll": {
        "add": {"component_groups": ["random_stroll"]},
        "queue_command": {"command": "msg @a[r=1500] §eRandom stroll behavior triggered."}  //for debug
      },

      "finished_random_stroll": {
        "set_property": {
          "var:finished_random_stroll": true
        },
        "queue_command": {"command": "msg @a[r=1500] §eFinished random stroll."}  //for debug
      },

      "finished_random_stroll_false": {
        "set_property": {
          "var:finished_random_stroll": false
        },
        "queue_command": {"command": "msg @a[r=1500] §eReset 'finished_random_stroll' to false."}  //for debug
      },

      "stop_move_to_random_block": {
        "remove": {"component_groups": ["move_to_random_block"]},
        "queue_command": {"command": "msg @a[r=1500] §eNo longer moving to random block."}  //for debug
      },

      "remove_random_stroll": {
        "remove": {"component_groups": ["random_stroll"]},
        "trigger": "finished_random_stroll_false",
        "queue_command": {"command": "msg @a[r=1500] §eStopping random stroll."}  //for debug
      },

      "restore_default_random_stroll": {
        "sequence": [
          {
            "trigger": "remove_random_stroll"
          },
          {
            "add": {"component_groups": ["default_random_stroll"]},
            "queue_command": {"command": "msg @a[r=1500] §eRestoring default random stroll behavior."}  //for debug
          }
        ]
      },

      // not used currently
      "timeout_random_stroll": {
        "remove": {"component_groups": ["random_stroll"]},
        "trigger": "find_spot_to_create_settlement",
        "queue_command": {"command": "msg @a[r=1500] §eTimed out random stroll."}  //for debug
      },

      // not used currently
      "stop_timeout_random_stroll": {
        "remove": {"component_groups": ["random_stroll"]},
        "trigger": "find_spot_to_create_settlement",
        "queue_command": {"command": "msg @a[r=1500] §eTimed out random stroll."}  //for debug
      },
      // --------- end of script stuff ^

      "governor_pillager": {
        "add": {"component_groups": ["governor_pillager"]},
        "queue_command": {"command": "msg @a[r=1500] §eNow a governor pillager."}  //for debug
      },

      "demote_governor_pillager": {
        "remove": {"component_groups": ["governor_pillager"]},
        "trigger": "belongs_to_settlement",
        "queue_command": {"command": "msg @a[r=1500] §eDemoted from governor."}  //for debug
      },

      "belongs_to_settlement": {
        "add": {"component_groups": ["belongs_to_settlement"]},
        "queue_command": {"command": "msg @a[r=1500] §eBelongs to a settlement."}  //for debug
      },

      "remove_belongs_to_settlement": {
        "remove": {"component_groups": ["belongs_to_settlement"]},
        "queue_command": {"command": "msg @a[r=1500] §eNo longer belongs to a settlement."}  //for debug
      },

      "target_acquired_during_search": {
        "sequence": [
          {
            "filters": {
              "any_of": [
                {"test": "is_family", "subject": "target", "value": "settled_pillager"},
                {"test": "is_family", "subject": "target", "value": "governor_pillager"}
              ]
            },
            "remove": {"component_groups": ["minecraft:melee_attack", "minecraft:ranged_attack"]},
            "trigger": "stop_avoiding_players_and_villagers"
          },
          {
            //got attacked, need to defend self
            "filters": {
              "none_of": [
                {"test": "is_family", "subject": "target", "value": "settled_pillager"},
                {"test": "is_family", "subject": "target", "value": "governor_pillager"}
              ]
            },
            "add": {"component_groups": ["minecraft:ranged_attack"]}
          }
        ]
      },

      "peaceful": {
        "sequence": [
          {
            "trigger": "remove_active_hostility",
            "set_property": { "var:peaceful_received": true }
          },
          {
            "set_property": { "var:not_peaceful_received": false }
          }
        ]
      },

      "not_peaceful": {
        "sequence": [
          {
            "set_property": { "var:not_peaceful_received": true },
            "trigger": "add_active_hostility"
          },
          {
            "set_property": { "var:peaceful_received": false }
          }
        ]
      },

      "add_active_hostility": {
        "add": {"component_groups": ["active_hostility"]},
        "queue_command": {
          "command": "msg @a[r=1500] §eable to look for targets."   //for debug
        }
      },

      "remove_active_hostility": {
        "remove": {"component_groups": ["active_hostility"]},
        "queue_command": {
          "command": "msg @a[r=1500] §eno longer looking for targets."   //for debug
        }
      },

      "add_equipment": {
        "add": {"component_groups": ["equipment"]}
      },

      "remove_equipment": {
        "remove": {"component_groups": ["equipment"]}
      },

      "add_able_to_breed": {
        "add": {"component_groups": ["able_to_breed"]},
        "queue_command": {
          "command": "msg @a[r=40] §eable to breed."   //for debug
        }
      },

      "remove_able_to_breed": {
        "remove": {"component_groups": ["able_to_breed"]},
        "queue_command": {
          "command": "msg @a[r=40] §eno longer able to breed."   //for debug
        }
      },

      "persistence_on": {
        "add": {"component_groups": ["persistence"]},
        "queue_command": {"command": "msg @a[r=1500] §ePersistence on."}  //for debug
      },

      "persistence_off": {
        "remove": {"component_groups": ["persistence"]},
        "queue_command": {"command": "msg @a[r=1500] §ePersistence off."} //for debug
      },

      "ticks_world_on": {
        "add": {"component_groups": ["ticks_world"]},
        "queue_command": {"command": "msg @a[r=1500] §eTicks world on."}  //for debug
      },

      "ticks_world_off": {
        "remove": {"component_groups": ["ticks_world"]},
        "queue_command": {"command": "msg @a[r=1500] §eTicks world off."}  //for debug
      },

      "minecraft:promote_to_illager_captain": {
        "add": {
          "component_groups": [
            "minecraft:ranged_attack",
            "minecraft:illager_squad_captain"
          ]
        },
        "remove": {
          "component_groups": [
            "minecraft:patrol_follower"
          ]
        }
      },

      "minecraft:promote_to_patrol_captain": {
        "add": {
          "component_groups": [
            "minecraft:ranged_attack",
            "minecraft:patrol_captain"
          ]
        },
        "remove": {
          "component_groups": [
            "minecraft:patrol_follower"
          ]
        }
      },

      "minecraft:melee_mode": {
        "remove": { "component_groups": [ "minecraft:ranged_attack" ] },
        "add": { "component_groups": [ "minecraft:melee_attack" ] }
      },

      "minecraft:ranged_mode": {
        "remove": { "component_groups": [ "minecraft:melee_attack" ] },
        "add": { "component_groups": [ "minecraft:ranged_attack" ] }
      },

      "minecraft:start_celebrating": { // Event must be called exactly this for village to fire it when a raid is lost
        "sequence": [
          {
            "add": { "component_groups": [ "minecraft:celebrate" ] }
          },
          {
            "filters": { "test": "has_nametag", "value": false },
            "remove": { "component_groups": [ "minecraft:raid_persistence" ] }
          }
        ]
      },

      "minecraft:stop_celebrating": {
        "remove": { "component_groups": [ "minecraft:celebrate" ] }
      },

      "minecraft:raid_expired": {
        "sequence": [
          {
            "filters": { "test": "has_nametag", "value": false },
            "remove": { "component_groups": [ "minecraft:raid_persistence" ] }
          }
        ]
      },

      "minecraft:calm": {
        "remove": { "component_groups": [ "minecraft:melee_attack", "minecraft:ranged_attack" ] }
      },

      //new
      "minecraft:ageable_grow_up": {
        "remove": {"component_groups": ["baby"]},
        "add": {"component_groups": ["equipment", "minecraft:ranged_attack"]}
      }


